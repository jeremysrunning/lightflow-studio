<Window x:Class="LightflowStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LightflowStudio"
 Title="Lightflow Studio" Icon="Assets/Branding/LightflowStudio.ico"
 Height="900" Width="1440" MinHeight="720" MinWidth="1120" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Window.Resources>
  <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
  <local:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility"/>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

  <!-- Shared dark "chip" chrome for every standalone Browser toolbar control (the search field, Sort, and
       the quick-filter segmented group) so the row reads as one purpose-designed toolbar rather than a row
       of default form controls with their own mismatched borders. -->
  <Style x:Key="BrowserToolbarChipStyle" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource ShellSurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
  </Style>

  <!-- Standalone dark toggle chip — Filter ▾. Checked (popup open) uses the same restrained
       selection/focus accent already used for the quick-filter segments and the grid's own tile selection,
       rather than a bright default ToggleButton chrome. -->
  <Style x:Key="BrowserToolbarToggleButtonStyle" TargetType="ToggleButton">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}"
       BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- #124 (revised): Include Subfolders lives in the media toolbar, immediately before the All/Images/RAW/Video
       group — scope narrows first, then the media-type controls narrow further, so reading order matches
       that pipeline. It keeps its own style rather than reusing BrowserToolbarToggleButtonStyle (Filter ▾'s
       chip) or BrowserQuickFilterSegmentStyle (the segmented group), so it never reads as a filter facet or
       as part of that segmented control, even though all three share the restrained checked-state accent
       already used throughout the Browser. The glyph shares the Locations tree's outline/filled folder
       vocabulary (see the HierarchicalDataTemplate below and MainWindow.SyncBrowserTreeRecursiveIcon): an
       outline folder (U+E8B7, already rendering elsewhere in this file) while unchecked, switching to a
       genuinely solid folder silhouette while checked. Hands-on testing found every available Segoe Fluent
       Icons/MDL2 Assets folder glyph (including U+E838, tried first) still read as an "open" folder rather
       than a filled one, so the filled state is a small hand-authored Path silhouette instead — a plain
       straight-edged tab-plus-body outline (no arcs, so its rendering can't depend on font/curve fidelity),
       sized and centered to match the outline glyph's footprint so switching states never shifts the
       "Subfolders" label. The label already names the operation, so the glyph itself only needs to read as
       on/off, not encode hierarchy on its own. -->
  <Style x:Key="BrowserScopeToggleButtonStyle" TargetType="ToggleButton">
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource ShellDividerBrush}"
       BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <StackPanel Orientation="Horizontal">
        <Grid Width="16" Height="13" VerticalAlignment="Center">
         <TextBlock x:Name="ScopeGlyphOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Text="&#xE8B7;"/>
         <Path x:Name="ScopeGlyphFilled" Visibility="Collapsed" Fill="{StaticResource MutedTextBrush}"
          Stretch="Uniform" Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
          Data="M1,2 L6,2 L7.5,4 L15,4 L15,12 L1,12 Z"/>
        </Grid>
        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Subfolders"/>
       </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter TargetName="ScopeGlyphOutline" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="ScopeGlyphFilled" Property="Visibility" Value="Visible"/>
        <!-- Same accent this style already uses for its own checked-state Chrome border, so the active
             toolbar icon and filled recursive tree icons read as one coherent Lightflow accent language
             rather than the tree's own separate folder color. -->
        <Setter TargetName="ScopeGlyphFilled" Property="Fill" Value="{StaticResource ShellFocusBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- One segment of the All/Images/RAW/Video group. Segments share one BrowserToolbarChipStyle outer
       Border (which clips their square corners into its own rounded shape) and divide with a thin right
       border rather than each carrying its own chip chrome, so the four read as one control. -->
  <Style x:Key="BrowserQuickFilterSegmentStyle" TargetType="ToggleButton">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/>
   <Setter Property="BorderThickness" Value="0,0,1,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <Grid>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- Restrained accent: a thin underline rather than a full bright fill, matching the rest of
             Lightflow's "selected = dark tint + accent line/border" convention. -->
        <Border x:Name="AccentBar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource ShellFocusBrush}" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
        <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- #125: compact hit area for the thumbnail-size slider's track, mirroring TrimEditorWindow's
       PlaybackTimelineHitArea — invisible, just enlarges the click target beyond the thin track itself. -->
  <Style x:Key="BrowserThumbnailSizeSliderHitArea" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- #125: a small, notched (4-position, snap-to-tick) slider — deliberately lightweight/media-focused
       rather than a standard form-control Slider, matching the status bar's restrained, subdued treatment. -->
  <Style x:Key="BrowserThumbnailSizeSliderStyle" TargetType="Slider">
   <Setter Property="Width" Value="64"/>
   <Setter Property="Height" Value="20"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid VerticalAlignment="Center" Height="20">
       <Border Height="3" VerticalAlignment="Center" Background="{StaticResource ShellDividerBrush}" CornerRadius="1.5"/>
       <!-- Decorative notch marks, one per BrowserGridLayout.ThumbnailSizes entry; purely visual (the real
            discrete stops come from IsSnapToTickEnabled/TickFrequency on the Slider itself), so a minor
            approximation versus the thumb's exact travel positions is acceptable. -->
       <UniformGrid Columns="6" VerticalAlignment="Center" Height="4" IsHitTestVisible="False">
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
       </UniformGrid>
       <Track x:Name="PART_Track" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton>
         <RepeatButton Style="{StaticResource BrowserThumbnailSizeSliderHitArea}" Command="{x:Static Slider.DecreaseLarge}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="11" Height="11" Focusable="False">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Ellipse x:Name="Knob" Fill="{StaticResource MutedTextBrush}" Stroke="{StaticResource ShellCanvasBrush}" StrokeThickness="1.5"/>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextBrush}"/></Trigger>
             <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{StaticResource ShellFocusBrush}"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Style="{StaticResource BrowserThumbnailSizeSliderHitArea}" Command="{x:Static Slider.IncreaseLarge}"/>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- #125: the small/large glyphs flanking the thumbnail-size slider are real, keyboard-reachable Buttons
       (one step per click, see MainWindow.ApplyBrowserThumbnailSize/StepLevel) rather than a decorative
       TextBlock with raw mouse handling. At rest they look identical to the plain glyph they replaced;
       hover/press/focus/disabled are the only visual difference, kept restrained to match this status bar's
       subdued language rather than reading as a conventional button. -->
  <Style x:Key="BrowserThumbnailSizeStepButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="3"/>
   <Setter Property="Margin" Value="0"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
       CornerRadius="4" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

  <Border Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,0,0,1" Padding="18,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="Assets/Branding/jr-glow-source.png" Width="38" Height="38" Stretch="Uniform"/>
     <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
      <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Text="Lightflow Studio"/>
      <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="9" Text="JEREMY RUNNING PHOTOGRAPHY"/>
     </StackPanel>
    </StackPanel>
    <ListBox Grid.Column="1" x:Name="Navigation" Style="{StaticResource NavigationList}" ItemContainerStyle="{StaticResource NavigationItem}"
     HorizontalAlignment="Center" VerticalAlignment="Center" SelectedIndex="{Binding ElementName=MainTabs, Path=SelectedIndex, Mode=TwoWay}"
     KeyboardNavigation.TabNavigation="Once" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBoxItem IsSelected="True" ToolTip="Browse media" AutomationProperties.Name="Browser workspace"><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" TextAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE8B7;"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Browser"/></Grid></ListBoxItem>
     <ListBoxItem AutomationProperties.Name="Encoding workspace"><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" TextAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE768;"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Encoding"/></Grid></ListBoxItem>
     <ListBoxItem><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" TextAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE8B1;"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Media Tools"/></Grid></ListBoxItem>
     <ListBoxItem><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" TextAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE81C;"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="History"/></Grid></ListBoxItem>
     <ListBoxItem><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" TextAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE943;"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Premiere Helper"/></Grid></ListBoxItem>
     <ListBoxItem><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" TextAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE713;"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Settings"/></Grid></ListBoxItem>
     <ListBoxItem><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" TextAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE946;"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="About"/></Grid></ListBoxItem>
    </ListBox>
   </Grid>
  </Border>

  <TabControl Grid.Row="1" x:Name="MainTabs" Style="{StaticResource ContentOnlyTabs}" SelectedIndex="0" KeyboardNavigation.TabNavigation="Local"
   SelectionChanged="MainTabs_SelectionChanged">
   <TabItem>
    <Grid Background="{StaticResource ShellCanvasBrush}" Margin="{StaticResource ShellWorkspacePadding}">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrowserNavigationColumn" Width="280" MinWidth="220" MaxWidth="520"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource ShellPanel}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionTitle}" FontSize="14" Text="Locations"/>
        <Grid Grid.Row="1" Margin="0,12,0,0">
         <ScrollViewer x:Name="BrowserFolderScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
          CanContentScroll="False" Padding="0,0,2,2" Focusable="False" Style="{StaticResource BrowserFolderScrollViewerStyle}">
         <TreeView x:Name="BrowserFolderTree" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" FocusVisualStyle="{x:Null}"
          SelectedItemChanged="BrowserFolderTree_SelectedItemChanged" PreviewMouseWheel="BrowserFolderTree_PreviewMouseWheel"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <TreeView.ItemContainerStyle>
           <Style TargetType="TreeViewItem" BasedOn="{StaticResource BrowserTreeItemStyle}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <EventSetter Event="Expanded" Handler="BrowserFolderTreeItem_Expanded"/>
           </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.Resources>
           <!-- #124 (further revised): folder icon uses filled/outline semantics rather than a two-folder
                stack, which read as too subtle in a large tree. FILLED means this row is active in Browser
                scope semantics — either it is the selected direct folder, or its effective Include Subfolders
                mode is ON (the stored recursive root or a visible/materialized inherited descendant); OUTLINE
                is everything else. Bound to the single authoritative BrowserTreeNode.IsFilledFolderIcon (OR of
                IsSelected and IsRecursiveScope, computed once in the model) rather than two independently
                firing DataTriggers each targeting the same properties — a prior revision's two-trigger version
                could visually behave as if only the most-recently-changed input mattered, letting a stored
                recursive root's icon incorrectly revert to outline whenever selection moved elsewhere, even
                though IsRecursiveScope itself never changed. One derived boolean removes any dependency on
                WPF trigger-precedence ordering entirely. The filled state is a small hand-authored Path
                silhouette (FolderIconFilled), not a font glyph: hands-on testing found every available Segoe
                Fluent Icons/MDL2 Assets folder codepoint — including U+E838, tried first — still read as an
                "open" folder rather than a genuinely filled one. The Path uses only straight edges (no arcs),
                so its rendering can't depend on font/curve fidelity, and is sized/centered to occupy the same
                18px icon column the outline glyph (FolderIcon, still U+E8B7) does, so switching states never
                shifts FolderLabel's position. Selection remains a separate row concern (background/outline)
                entirely independent of this icon — a recursive descendant is never selected merely because
                its icon is filled. Computed per-row from RootId/RelativeFolder without materializing
                collapsed descendants. -->
           <HierarchicalDataTemplate DataType="{x:Type local:BrowserTreeNode}" ItemsSource="{Binding Children, Mode=OneWay}">
            <Grid Height="26" ToolTip="{Binding Diagnostic, Mode=OneWay}">
             <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock x:Name="FolderIcon" VerticalAlignment="Center" TextAlignment="Center" Foreground="#E4B85A"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE8B7;"/>
             <!-- Filled icons use the same Lightflow accent brush BrowserScopeToggleButtonStyle's own
                  checked-state border already uses (ShellFocusBrush), not the outline glyph's own folder
                  color — a folder being active in Browser scope semantics reads as distinctly Lightflow
                  rather than as a generic (Explorer-like) filled-folder color. -->
             <Path x:Name="FolderIconFilled" Visibility="Collapsed" Fill="{StaticResource ShellFocusBrush}" Stretch="Uniform"
              Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M1,2 L6,2 L7.5,4 L15,4 L15,12 L1,12 Z"/>
             <TextBlock x:Name="FolderLabel" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
             <TextBlock Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding StorageStatus, Mode=OneWay}"/>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
             <DataTrigger Binding="{Binding IsStorageLocation}" Value="True"><Setter TargetName="FolderLabel" Property="FontWeight" Value="SemiBold"/></DataTrigger>
             <DataTrigger Binding="{Binding IsFilledFolderIcon}" Value="True">
              <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="FolderIconFilled" Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
           </HierarchicalDataTemplate>
          </TreeView.Resources>
         </TreeView>
         </ScrollViewer>
         <StackPanel x:Name="BrowserRootsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
          <TextBlock Foreground="{StaticResource MutedTextBrush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center" Text="&#xE838;"/>
          <TextBlock Style="{StaticResource ShellPlaceholderText}" Margin="0,10,0,0" Text="No storage locations are currently available."/>
         </StackPanel>
        </Grid>
       </Grid>
      </Border>
      <GridSplitter x:Name="BrowserNavigationSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
       VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"
       Cursor="SizeWE" ToolTip="Drag to resize folder navigation" AutomationProperties.Name="Resize folder navigation">
       <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"/></ControlTemplate></GridSplitter.Template>
      </GridSplitter>
      <Grid Grid.Column="2" MinWidth="520">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="BrowserNavigationGap" Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border x:Name="BrowserNavigationToolbar" Style="{StaticResource ShellPanel}" Padding="12,9">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal">
          <Button x:Name="BrowserBackButton" Width="38" Padding="0,7" IsEnabled="False" ToolTip="Back" AutomationProperties.Name="Back" Click="BrowserBack_Click" Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
          <Button x:Name="BrowserForwardButton" Width="38" Padding="0,7" IsEnabled="False" ToolTip="Forward" AutomationProperties.Name="Forward" Click="BrowserForward_Click" Content="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
          <Button x:Name="BrowserUpButton" Width="38" Padding="0,7" IsEnabled="False" ToolTip="Up one folder" AutomationProperties.Name="Up one folder" Click="BrowserUp_Click" Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
         </StackPanel>
         <TextBox Grid.Column="1" x:Name="BrowserCurrentPath" Margin="14,0,6,0" VerticalAlignment="Center" Text="" ToolTip="Type a local, mapped, or network folder path" AutomationProperties.Name="Current folder path" KeyDown="BrowserCurrentPath_KeyDown"/>
         <Button Grid.Column="2" x:Name="BrowserGoButton" Padding="12,7" Content="Go" ToolTip="Open the entered folder" AutomationProperties.Name="Open folder path" Click="BrowserGo_Click"/>
         <Button Grid.Column="3" x:Name="BrowserRefreshButton" Width="38" Padding="0,7" IsEnabled="False" ToolTip="Refresh current folder" AutomationProperties.Name="Refresh current folder" Click="BrowserRefresh_Click" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        </Grid>
       </Border>
       <!--
        #109's media-area toolbar: narrows and presents the scope the Locations sidebar already chose.
        Search/filter/sort/status live here, never in the left sidebar, and never inside folder navigation.
       -->
       <Border Grid.Row="2" x:Name="BrowserQueryToolbar" Style="{StaticResource ShellPanel}" Padding="10,8" IsEnabled="False">
        <StackPanel>
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/>
           <ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/>
           <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
           <ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- #124: scope narrows the candidate set first; the media-type controls immediately to its right
               then narrow that same query-facing view further — placement mirrors that pipeline order. The
               wider (16px, vs. the 10px used everywhere else in this row) gap that follows is the only thing
               separating it from the segmented group: enough that it doesn't read as one of those segments,
               not so much that it reads as unrelated to the media controls it scopes. IsEnabled/IsChecked
               reflect BrowserNavigationSession.ScopeMode — see MainWindow.SyncBrowserScopeToggle — and this
               control never writes to BrowserQuery. -->
          <ToggleButton x:Name="BrowserIncludeSubfoldersButton" Style="{StaticResource BrowserScopeToggleButtonStyle}" IsEnabled="False"
           ToolTip="Include Subfolders — browse this folder and every descendant folder as one media set"
           AutomationProperties.Name="Include Subfolders" Click="BrowserIncludeSubfoldersButton_Click"/>
          <!-- Independent per-category toggles (multiple may be active; OR within the facet), presented as
               one segmented control; Filter ▾ (below) additionally supports stacking with other, future
               fields for the compound case this row cannot express alone. Both read/write the same
               BrowserQuery.Filters and stay in sync — see MainWindow.SyncBrowserQueryToolbarVisuals.
               "All" is the only statically-declared segment (it isn't a media type); one toggle per
               BrowserGridModel.PresentableCategories is appended after it from code-behind
               (InitializeBrowserQuickFilterButtons) so the row can never drift from what the grid actually
               presents. -->
          <Border Grid.Column="2" Style="{StaticResource BrowserToolbarChipStyle}" ClipToBounds="True" ToolTip="Toggle media types shown">
           <StackPanel x:Name="BrowserQuickFilterSegments" Orientation="Horizontal">
            <ToggleButton x:Name="BrowserQuickFilterAllButton" Style="{StaticResource BrowserQuickFilterSegmentStyle}" Content="All"
             AutomationProperties.Name="Show all media types" Click="BrowserQuickFilterAllButton_Click"/>
           </StackPanel>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource BrowserToolbarChipStyle}" MinWidth="170">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Text="&#xE721;"/>
            <Grid Grid.Column="1" Margin="7,0,10,0">
             <TextBox x:Name="BrowserSearchBox" Background="Transparent" BorderThickness="0" Margin="0" Padding="0,7"
              VerticalAlignment="Center" ToolTip="Search filename or path within this scope (Ctrl+F)"
              AutomationProperties.Name="Search media" TextChanged="BrowserSearchBox_TextChanged"/>
             <TextBlock VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedTextBrush}"
              Text="Search assets…" Visibility="{Binding Text, ElementName=BrowserSearchBox, Converter={StaticResource StringEmptyToVisibility}}"/>
            </Grid>
           </Grid>
          </Border>
          <!-- Progressive disclosure: Filter ▾ opens a compact predicate editor rather than exposing a
               permanent row of one-off filter controls; active predicates surface as removable chips
               beneath, appearing only while at least one is active. -->
          <ToggleButton Grid.Column="6" x:Name="BrowserFilterButton" Style="{StaticResource BrowserToolbarToggleButtonStyle}" Content="Filter &#x25BE;"
           ToolTip="Add a filter" AutomationProperties.Name="Add a filter"/>
          <Popup x:Name="BrowserFilterPopup" IsOpen="{Binding IsChecked, ElementName=BrowserFilterButton, Mode=TwoWay}"
           PlacementTarget="{Binding ElementName=BrowserFilterButton}" Placement="Bottom" VerticalOffset="4"
           StaysOpen="False" AllowsTransparency="True">
           <Border Width="208" Padding="14" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <TextBlock Style="{StaticResource FieldLabel}" Margin="4,0,4,4" Text="MEDIA TYPE"/>
             <!-- IsChecked is synced from code-behind once a predicate is added/removed, not declared here —
                  see the SelectedIndex note on BrowserSortCombo below for why nothing here sets a XAML default. -->
             <CheckBox x:Name="BrowserFilterImagesCheck" Margin="4,7,4,0" Content="Images"
              Checked="BrowserFilterImagesCheck_Changed" Unchecked="BrowserFilterImagesCheck_Changed"/>
             <CheckBox x:Name="BrowserFilterRawCheck" Margin="4,11,4,0" Content="RAW"
              Checked="BrowserFilterRawCheck_Changed" Unchecked="BrowserFilterRawCheck_Changed"/>
             <CheckBox x:Name="BrowserFilterVideoCheck" Margin="4,11,4,0" Content="Video"
              Checked="BrowserFilterVideoCheck_Changed" Unchecked="BrowserFilterVideoCheck_Changed"/>
             <TextBlock Margin="4,14,4,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" LineHeight="16" TextWrapping="Wrap"
              Text="More filters (date, size, camera, and more) arrive here over time."/>
            </StackPanel>
           </Border>
          </Popup>
          <!-- Sort reads as one control — a muted "Sort" label plus the field and its direction affordance,
               sharing one chip chrome — rather than a ComboBox next to a visually disconnected square
               button. SelectedIndex is set from code-behind (ResetBrowserQueryToolbar) once a folder
               actually loads, not declared here: WPF can raise SelectionChanged while InitializeComponent
               is still connecting later-declared named elements, and the handler reads sibling controls
               that would not exist yet. -->
          <Border Grid.Column="8" Style="{StaticResource BrowserToolbarChipStyle}">
           <StackPanel Orientation="Horizontal">
            <TextBlock Margin="10,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Sort"/>
            <ComboBox x:Name="BrowserSortCombo" MinWidth="132" Background="Transparent" BorderThickness="0" Margin="0" VerticalAlignment="Center"
             ToolTip="Sort by" AutomationProperties.Name="Sort by" SelectionChanged="BrowserSortCombo_SelectionChanged">
             <ComboBoxItem Content="Name"/>
             <ComboBoxItem Content="Capture date"/>
             <ComboBoxItem Content="Modified date"/>
             <ComboBoxItem Content="Media type"/>
             <ComboBoxItem Content="File size"/>
             <ComboBoxItem Content="Duration"/>
            </ComboBox>
            <Border Width="1" Margin="0,7" Background="{StaticResource ShellDividerBrush}"/>
            <Button x:Name="BrowserSortDirectionButton" Width="32" Padding="0,7" Background="Transparent" BorderThickness="0" Margin="0" Content="&#xE70E;"
             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Sort ascending (click to reverse)"
             AutomationProperties.Name="Toggle sort direction" Click="BrowserSortDirection_Click"/>
           </StackPanel>
          </Border>
         </Grid>
         <!-- Collapsed (and empty) whenever no predicate is active, so the toolbar stays a single quiet row
              for ordinary browsing — see MainWindow.SyncBrowserQueryToolbarVisuals. -->
         <ItemsControl x:Name="BrowserFilterChips" Margin="0,8,0,0" Visibility="Collapsed" Focusable="False">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate DataType="{x:Type local:BrowserFilterPredicate}">
            <Border Background="{StaticResource ShellSelectionBrush}" BorderBrush="{StaticResource ShellDividerBrush}"
             BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
             <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="12" Text="{Binding Label}"/>
              <Button Margin="6,0,0,0" Padding="4,0" Background="Transparent" BorderThickness="0"
               Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="Bold" Content="×"
               ToolTip="Remove this filter" AutomationProperties.Name="{Binding RemoveAutomationLabel}"
               Click="BrowserFilterChip_Remove_Click"/>
             </StackPanel>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
       <!-- The one authoritative background for the whole media canvas (loading/content/empty/failure alike)
            — every descendant surface between this Border and an individual tile's own card chrome is
            deliberately Transparent (never merely unset) so nothing but this single Background can ever paint
            behind the grid. UseLayoutRounding scopes pixel-snapping to this subtree specifically (rather than
            the whole Window) — adjacent same-color panels/rows positioned at fractional device-pixel offsets
            (routine for a "*"-sized row inside a Grid with several "Auto" siblings, see the toolbar rows
            above) render with a faint anti-aliased seam between them even when their fill colors are
            identical; rounding every descendant's layout to whole device pixels here removes that seam at its
            source instead of papering over it with an opaque overlay. -->
       <Border Grid.Row="4" x:Name="BrowserGridHost" Style="{StaticResource ShellPanel}" Background="#0D0F13" Padding="14"
        UseLayoutRounding="True" SizeChanged="BrowserGridHost_SizeChanged" MouseLeftButtonDown="BrowserGridHost_MouseLeftButtonDown">
        <Grid Background="Transparent">
         <ItemsControl x:Name="BrowserGridRows" Background="Transparent" Focusable="True" KeyDown="BrowserGridRows_KeyDown"
          AutomationProperties.Name="Media grid"
          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
          <ItemsControl.Template>
           <ControlTemplate TargetType="ItemsControl">
            <!-- #110: named so MainWindow can resolve it via the existing FindDescendantByName visual-tree
                 helper to capture/restore scroll position around the Player/Viewer — it has no codegen field
                 of its own since names inside a ControlTemplate aren't connected by InitializeComponent. -->
            <ScrollViewer x:Name="BrowserGridScrollViewer" Background="Transparent" Focusable="False" Padding="{TemplateBinding Padding}"
             HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
             <ItemsPresenter/>
            </ScrollViewer>
           </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
           <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical" Background="Transparent"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate DataType="{x:Type local:BrowserGridRow}">
            <ItemsControl Background="Transparent" Focusable="False" ItemsSource="{Binding Tiles}">
             <!-- Horizontal, non-wrapping: each row already contains exactly as many tiles as
                  BrowserGridLayout.ComputeColumns fit, so this panel must never make its own
                  independent wrap decision that could disagree with that count and misalign rows. -->
             <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Background="Transparent"/></ItemsPanelTemplate>
             </ItemsControl.ItemsPanel>
             <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:BrowserGridTile}">
               <!-- #125: Width/thumbnail-area height come from Window.Resources (BrowserTileWidth/
                    BrowserTileThumbnailHeight), the one authoritative presentation-size value the slider
                    updates — see MainWindow.ApplyBrowserThumbnailSize. DynamicResource (not StaticResource)
                    is required: it re-resolves for every realized/recycled tile whenever those resources
                    change, including tiles the slider changes while virtualized out of view. -->
               <Border Width="{DynamicResource BrowserTileWidth}" Margin="0,0,12,12" Padding="7" CornerRadius="6" BorderThickness="1"
                MouseLeftButtonDown="BrowserGridTile_MouseLeftButtonDown"
                ToolTip="{Binding Name}" AutomationProperties.Name="{Binding AutomationLabel}">
                <Border.Style>
                 <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource ShellPanelBrush}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </Border.Style>
                <Grid>
                 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                 <Border Height="{DynamicResource BrowserTileThumbnailHeight}" Background="#05070A" CornerRadius="4" ClipToBounds="True">
                  <Grid>
                   <Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/>
                   <TextBlock Text="{Binding CategoryGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                    Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}"/>
                   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="22" Height="22"
                    CornerRadius="11" Background="{StaticResource ShellFocusBrush}"
                    Visibility="{Binding HasUserAuthoredState, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="{Binding AssetStateLabel}" AutomationProperties.Name="{Binding AssetStateLabel}">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                     Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                   </Border>
                  </Grid>
                 </Border>
                 <StackPanel Grid.Row="1" Margin="1,7,1,0">
                  <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                 </StackPanel>
                </Grid>
               </Border>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
         <StackPanel x:Name="BrowserEmptyState" MaxWidth="460" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="BrowserEmptyTitle" Style="{StaticResource ShellPlaceholderTitle}" Text="Choose a storage location"/>
          <TextBlock x:Name="BrowserEmptyMessage" Style="{StaticResource ShellPlaceholderText}" Margin="0,8,0,0" Text="Select a drive, mapped location, or managed library to browse its folders and supported media."/>
         </StackPanel>
         <Border x:Name="BrowserLoadingOverlay" Background="#B00D0F13" Visibility="Collapsed">
          <!-- #124: a real progress indicator, not a decorative accent line — MainWindow.RunBrowserNavigationAsync
               resets it to indeterminate at the start of every navigation, and
               MainWindow.ApplyRecursiveScopeLoadingProgress switches it to determinate only once
               BrowserNavigationSession.RecursiveScopeProgressChanged reports enough of the recursive walk is
               known to be a truthful, non-fake percentage (see RecursiveScopeProgress). Direct-mode
               navigation never receives progress events at all, so it stays indeterminate throughout. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
           <ProgressBar x:Name="BrowserLoadingProgressBar" Width="180" Height="4" IsIndeterminate="True"/>
           <TextBlock x:Name="BrowserLoadingText" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Loading folder…"/>
          </StackPanel>
         </Border>
        </Grid>
      </Border>
      <!-- #110: the Browser's Player/Viewer presentation state. A sibling occupying the exact same cell as
           BrowserGridHost above, toggled by Visibility (mirroring how BrowserLoadingOverlay/BrowserEmptyState
           already overlay that same host) rather than a second host elsewhere in the tree — the surrounding
           navigation bar, query toolbar, Locations tree, and status bar all stay exactly as they are while only
           this one region's content changes. Content is a lazily-created PlayerViewerHost instance (see
           MainWindow.EnsurePlayerViewerHost) so the reusable Player/Viewer content is never directly dependent
           on MainWindow — this ContentControl only ever hosts it. -->
      <ContentControl Grid.Row="4" x:Name="BrowserPlayerHost" Focusable="False" Visibility="Collapsed"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="28,24,28,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="2,0,0,20">
       <TextBlock Style="{StaticResource PageTitle}" Text="Batch Encode"/>
       <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" Text="Apply a LUT and create consistent, edit-ready H.264 files from an entire folder."/>
      </StackPanel>

      <Border Grid.Row="1" x:Name="BatchConfiguration" Style="{StaticResource Card}">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Margin="4,0,4,12" Text="Batch Setup"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="BatchSourceConfiguration">
         <TextBlock Style="{StaticResource FieldLabel}" Text="VIDEO FOLDER"/>
         <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseInput_Click"/><TextBox x:Name="InputFolder" TextChanged="InputFolder_TextChanged"/></DockPanel>
         <CheckBox x:Name="Recursive" Margin="6,5,6,0" Content="Include subfolders" Checked="Recursive_Changed" Unchecked="Recursive_Changed"/>
        </StackPanel>
        <Expander Grid.Row="2" Grid.ColumnSpan="2" Margin="4,8,4,0" IsExpanded="False">
         <Expander.Header>
          <StackPanel Orientation="Horizontal">
           <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="Files in this batch"/>
           <TextBlock x:Name="BatchFileSummary" Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Choose a folder to see its videos"/>
          </StackPanel>
         </Expander.Header>
         <Border x:Name="BatchFileContent" Margin="0,8,0,2" Background="#111318" BorderBrush="#303540" BorderThickness="1" CornerRadius="7" Padding="10">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
             <Button Padding="10,5" Content="All" Click="SelectAllBatchFiles_Click"/>
             <Button Padding="10,5" Content="None" Click="SelectNoBatchFiles_Click"/>
             <Button Padding="10,5" Content="Refresh" Click="RefreshBatchFiles_Click"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Uncheck any videos you want to skip."/>
           </DockPanel>
           <Grid Grid.Row="1" Margin="6,0,14,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="88"/><ColumnDefinition Width="76"/><ColumnDefinition Width="90"/><ColumnDefinition Width="84"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="FILE"/>
            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="RESOLUTION"/>
            <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="FRAME RATE"/>
            <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="DURATION"/>
            <TextBlock Grid.Column="5" Style="{StaticResource FieldLabel}" Text="SIZE"/>
            <TextBlock Grid.Column="6" Style="{StaticResource FieldLabel}" Text="STATUS"/>
            <TextBlock Grid.Column="7" Style="{StaticResource FieldLabel}" Text="TRIM"/>
           </Grid>
           <ListBox Grid.Row="2" x:Name="BatchFileList" MaxHeight="230" BorderThickness="0" Background="Transparent"
            HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
             <DataTemplate>
              <Grid Margin="2,5" ToolTip="{Binding DetailsTooltip}">
               <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="88"/><ColumnDefinition Width="76"/><ColumnDefinition Width="90"/><ColumnDefinition Width="84"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
               <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="BatchFileSelection_Click"/>
               <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/></Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                <local:TrimRangeIndicator Grid.Row="1" Margin="1,1,1,0"
                 HasActiveTrim="{Binding HasActiveTrim}" HasProportions="{Binding TrimIndicatorHasProportions}"
                 StartFraction="{Binding TrimIndicatorStart}" WidthFraction="{Binding TrimIndicatorWidth}"/>
               </Grid>
               <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ResolutionText}"/>
               <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding FrameRateText}"/>
               <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding DurationText}"/>
               <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding SizeText}"/>
               <Border Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#3B3218" BorderBrush="#8A7122" BorderThickness="1" CornerRadius="8" Padding="7,2" ToolTip="{Binding WarningTooltip}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasWarning}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Foreground="#F2D46B" FontSize="10" FontWeight="SemiBold" Text="{Binding WarningLabel}"/>
               </Border>
               <Button Grid.Column="7" Padding="8,4" Margin="2" Content="{Binding TrimActionText}" IsEnabled="{Binding CanTrim}" Click="TrimBatchFile_Click"/>
              </Grid>
             </DataTemplate>
            </ListBox.ItemTemplate>
           </ListBox>
          </Grid>
         </Border>
        </Expander>
        <Border Grid.Row="3" Grid.ColumnSpan="2" x:Name="BatchOutputConfiguration" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="#2A2E37" BorderThickness="0,1,0,0">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,8,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="OUTPUT LOCATION"/>
          <ComboBox x:Name="OutputMode" SelectionChanged="OutputMode_SelectionChanged"><ComboBoxItem Content="Same folder as source"/><ComboBoxItem Content="Subfolder"/><ComboBoxItem Content="Specific folder"/></ComboBox>
         </StackPanel>
         <StackPanel Grid.Column="1" x:Name="OutputSameFolderPanel" Margin="8,0,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="FILENAME SUFFIX"/>
          <TextBox x:Name="OutputFilenameSuffix" TextChanged="OutputFilenameSuffix_TextChanged" LostKeyboardFocus="OutputDestination_LostKeyboardFocus"/>
         </StackPanel>
         <StackPanel Grid.Column="1" x:Name="OutputSubfolderPanel" Margin="8,0,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="SUBFOLDER NAME"/>
          <TextBox x:Name="OutputSubfolderName" TextChanged="OutputSubfolderName_TextChanged" LostKeyboardFocus="OutputDestination_LostKeyboardFocus"/>
         </StackPanel>
         <StackPanel Grid.Column="1" x:Name="OutputSpecificPanel" Margin="8,0,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="SPECIFIC OUTPUT FOLDER"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOutputFolder_Click"/><TextBox x:Name="OutputSpecificFolder" LostKeyboardFocus="OutputDestination_LostKeyboardFocus"/></DockPanel>
         </StackPanel>
         <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
          <CheckBox x:Name="PreserveFolderStructure" Margin="6,5,6,0" Content="Preserve source folder structure" Visibility="Collapsed" ToolTip="Keep each file in the same relative subfolder beneath the output location."/>
          <CheckBox x:Name="OverwriteExisting" Margin="6,5,6,0" Content="Overwrite existing files"/>
         </WrapPanel>
        </Grid>
        </Border>
        <StackPanel Grid.Row="4" Grid.Column="0" x:Name="BatchLutConfiguration" Margin="0,10,8,0">
         <TextBlock Style="{StaticResource FieldLabel}" Text="LUT"/>
         <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshLuts_Click"/><ComboBox x:Name="LutSelection" DisplayMemberPath="DisplayName" SelectedValuePath="FilePath" SelectionChanged="LutSelection_SelectionChanged"/></DockPanel>
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" x:Name="BatchFormatConfiguration" Margin="8,10,0,0">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource FieldLabel}" Text="RESOLUTION"/><ComboBox x:Name="Resolution" SelectedIndex="2" SelectionChanged="Resolution_SelectionChanged"><ComboBoxItem Content="480p (854×480)"/><ComboBoxItem Content="720p (1280×720)"/><ComboBoxItem Content="1080p (1920×1080)"/><ComboBoxItem Content="1440p (2560×1440)"/><ComboBoxItem Content="4K UHD (3840×2160)"/><ComboBoxItem Content="Source resolution"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="RECOVERY MODE"/><ComboBox x:Name="RecoveryMode" SelectedIndex="0"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Salvage audio + video"/><ComboBoxItem Content="Video only"/></ComboBox></StackPanel>
         </Grid>
        </StackPanel>
       </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="0,0,0,14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="BatchStateBorder" Background="#17241F" BorderBrush="#285845" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="2,0,8,0">
         <TextBlock x:Name="BatchStateText" Foreground="{StaticResource SuccessBrush}" FontSize="11" Text="READY"/>
        </Border>
        <TextBlock x:Name="CurrentFileText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Choose a video folder to begin" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="CancelButton" Style="{StaticResource DangerButton}" Content="Cancel" IsEnabled="False" Click="Cancel_Click"/>
        <Button x:Name="PauseButton" Content="Pause" IsEnabled="False" Click="Pause_Click"/>
        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Start Encoding" IsEnabled="False" Click="Start_Click"/>
       </StackPanel>
      </Grid>

      <Grid Grid.Row="3">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Style="{StaticResource Card}">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Style="{StaticResource SectionTitle}" Margin="4,0,4,12" Text="Encoding Progress"/>
         <DockPanel Grid.Row="1" Margin="4,0,4,4" LastChildFill="False"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Current file"/><TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="{StaticResource OrangeBrush}" Text="ACTIVE"/></DockPanel>
         <ProgressBar Grid.Row="2" x:Name="FileProgress" Style="{StaticResource FileProgressStyle}" Maximum="100"/>
         <DockPanel Grid.Row="3" Margin="4,14,4,4" LastChildFill="False"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Overall batch"/><TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" x:Name="EtaText" Foreground="{StaticResource MutedTextBrush}"/></DockPanel>
         <ProgressBar Grid.Row="4" x:Name="BatchProgress" Maximum="100"/>
        </Grid>
       </Border>
       <Border Grid.Row="1" Style="{StaticResource Card}">
        <Expander x:Name="ActivityLogExpander" IsExpanded="False">
         <Expander.Header><TextBlock Style="{StaticResource SectionTitle}" Text="Activity Log"/></Expander.Header>
         <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <CheckBox x:Name="ShowEncodingDetails" HorizontalAlignment="Right" Margin="4,0,4,8" Content="Show encoding details"
           Checked="ShowEncodingDetails_Changed" Unchecked="ShowEncodingDetails_Changed"
           ToolTip="Include technical encoding messages from FFmpeg and additional file details in the activity log."/>
          <TextBox Grid.Row="1" x:Name="LogBox" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" VerticalScrollBarVisibility="Auto"/>
         </Grid>
        </Expander>
       </Border>
      </Grid>
     </Grid>
    </ScrollViewer>
   </TabItem>

   <TabItem>
    <Grid Margin="28,24,28,28">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="2,0,0,20"><TextBlock Style="{StaticResource PageTitle}" Text="Media Tools"/><TextBlock Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" Text="Inspect, verify, rewrap, proxy, or create a visual contact sheet from one media file."/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="MEDIA FILE"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseMedia_Click"/><TextBox x:Name="MediaPath"/></DockPanel></StackPanel>
     </Border>
     <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Margin="4,0,4,10" Text="Choose an action"/>
       <WrapPanel><Button Content="Inspect Metadata" Click="Inspect_Click"/><Button Content="Verify / CSV Report" Click="Verify_Click"/><Button Content="Lossless Rewrap" Click="Rewrap_Click"/><Button Content="Create 1080p Proxy" Click="Proxy_Click"/><Button Content="Generate Contact Sheet" Click="ContactSheet_Click"/></WrapPanel>
      </StackPanel>
     </Border>
     <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Style="{StaticResource SectionTitle}" Margin="4,0,4,10" Text="Tool Output"/><TextBox Grid.Row="1" x:Name="ToolsOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" VerticalScrollBarVisibility="Auto"/></Grid></Border>
    </Grid>
   </TabItem>

   <TabItem>
    <Grid Margin="28,24,28,28">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="2,0,0,20">
      <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshHistory_Click"/>
      <StackPanel><TextBlock Style="{StaticResource PageTitle}" Text="History"/><TextBlock Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" Text="Review completed Encoding jobs and restore safe inputs for another run."/></StackPanel>
     </DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,10,0">
       <Grid><TextBlock x:Name="HistoryEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="No completed jobs yet."/>
        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" SelectionChanged="HistoryList_SelectionChanged">
         <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding CompletedDisplay}"/><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="{Binding CapabilityDisplay}"/></DockPanel>
          <TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="{StaticResource OrangeBrush}" Text="{Binding StateDisplay}"/>
          <TextBlock Grid.Row="2" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Text="{Binding SummaryDisplay}"/>
         </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Style="{StaticResource SectionTitle}" Text="Job details"/>
       <TextBox Grid.Row="1" x:Name="HistoryDetails" Margin="0,12,0,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Text="Select a job to inspect its results."/>
       <Button Grid.Row="2" x:Name="HistoryRerunButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Content="Review &amp; Rerun" IsEnabled="False" Click="RerunHistory_Click"/>
      </Grid></Border>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28,24,28,28">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="2,0,0,20"><TextBlock Style="{StaticResource PageTitle}" Text="Premiere Helper"/><TextBlock Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" Text="Export individual timeline clips from Premiere Pro with the included ExtendScript workflow."/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
       <StackPanel Margin="4"><TextBlock Style="{StaticResource SectionTitle}" Text="Experimental timeline exporter"/><TextBlock Margin="0,10,20,16" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="20" Text="The included helper exports each clip on video track V1 as an individual file using sequence In/Out points. Visible timeline effects and adjustment layers are included. Test on a duplicate project first."/><Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Content="Open Premiere Helper Folder" Click="OpenPremiere_Click"/></StackPanel>
       <Image Grid.Column="1" Source="Assets/Branding/jr-glow-source.png" Stretch="Uniform" Opacity="0.78"/>
      </Grid>
     </Border>
     <Border Grid.Row="2" Background="#1D171B" BorderBrush="#55303C" BorderThickness="1" CornerRadius="9" Padding="14"><TextBlock Foreground="#E9BAC7" TextWrapping="Wrap" Text="Tip: duplicate the Premiere project before running timeline automation, and confirm the Adobe Media Encoder preset before a long export."/></Border>
    </Grid></ScrollViewer>
   </TabItem>

   <TabItem>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28,24,28,28">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="2,0,0,20"><TextBlock Style="{StaticResource PageTitle}" Text="Settings"/><TextBlock Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" Text="Choose the folders, tools, and defaults restored whenever the application starts."/></StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Margin="4,0,4,12" Text="Folders"/>
       <StackPanel Grid.Row="1" Grid.ColumnSpan="2"><TextBlock Style="{StaticResource FieldLabel}" Text="DEFAULT VIDEO FOLDER"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseDefaultVideoFolder_Click"/><TextBox x:Name="SettingsDefaultVideoFolder"/></DockPanel></StackPanel>
       <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="SCREENGRAB FOLDER"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseScreengrabFolder_Click"/><TextBox x:Name="SettingsScreengrabDirectory"/></DockPanel></StackPanel>
       <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="LUT LIBRARY FOLDER"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseSettingsLutFolder_Click"/><TextBox x:Name="SettingsLutFolder"/></DockPanel></StackPanel>
     </Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Margin="4,0,4,10" Text="Lightflow Storage"/>
      <Border Background="#111319" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4,0,4,10"><StackPanel>
       <DockPanel><Button DockPanel.Dock="Right" Content="Change…" Click="ChangeCatalogLocation_Click"/><StackPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="Catalog Location"/><TextBlock Margin="0,4,16,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Contains important Lightflow library data. Changing this location performs a protected migration and keeps the original Catalog. The live Catalog must remain on a local drive; mapped network drives are unsupported."/></StackPanel></DockPanel>
       <TextBox x:Name="SettingsCatalogDirectory" Margin="4,8,4,0" IsReadOnly="True"/>
      </StackPanel></Border>
      <Border Background="#111319" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4,0,4,0"><StackPanel>
       <DockPanel><Button x:Name="ChangePreviewsLocationButton" DockPanel.Dock="Right" Content="Change…" Click="ChangePreviewsLocation_Click"/><StackPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="Previews Location"/><TextBlock Margin="0,4,16,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Previews can use significant disk space. They are rebuildable and may be moved to another drive independently."/></StackPanel></DockPanel>
       <TextBox x:Name="SettingsPreviewsDirectory" Margin="4,8,4,0" IsReadOnly="True"/>
       <Grid Margin="4,10,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PreviewUsageText" Foreground="{StaticResource MutedTextBrush}" Text="Calculating Preview usage…"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Cache limit"/><TextBox x:Name="SettingsPreviewCacheQuotaGb" Width="70" Margin="8,0,4,0"/><TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="GB"/></StackPanel></StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="RefreshPreviewUsageButton" Content="Refresh Usage" Click="RefreshPreviewUsage_Click"/><Button x:Name="CleanupPreviewsButton" Content="Clean Up" Click="CleanupPreviews_Click"/><Button x:Name="ClearPreviewsButton" Content="Clear…" Click="ClearPreviews_Click"/><Button x:Name="RebuildPreviewsButton" Content="Rebuild…" Click="RebuildPreviews_Click"/><Button x:Name="CancelPreviewMaintenanceButton" Content="Cancel" Visibility="Collapsed" Click="CancelPreviewMaintenance_Click"/></WrapPanel>
       </Grid>
       <ProgressBar x:Name="PreviewMaintenanceProgress" Margin="4,8,4,0" Height="8" Minimum="0" Maximum="1" Visibility="Collapsed"/>
       <TextBlock x:Name="PreviewMaintenanceStatus" Margin="4,6,4,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Background="#111319" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4,10,4,0"><StackPanel>
       <DockPanel><StackPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="Catalog Backup &amp; Recovery"/><TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Lightflow keeps validated Catalog backups separately from rebuildable Previews. Restore is explicit and protects the current Catalog before making changes."/></StackPanel></DockPanel>
       <ComboBox x:Name="CatalogBackupSelection" Margin="4,10,4,0" DisplayMemberPath="DisplayName"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Back Up Now" Click="BackupCatalog_Click"/><Button Content="Restore Selected…" Click="RestoreCatalog_Click"/></StackPanel>
      </StackPanel></Border>
     </StackPanel></Border>
     <Border Grid.Row="3" Style="{StaticResource Card}"><StackPanel>
      <DockPanel Margin="4,0,4,10"><Button DockPanel.Dock="Right" Content="Add Media Root…" Click="AddMediaRoot_Click"/><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Media Roots"/><TextBlock Margin="0,4,16,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Stable Catalog locations for originals. Each computer connects the same logical root to its own folder path."/></StackPanel></DockPanel>
      <TextBlock x:Name="MediaRootsEmptyText" Margin="4,8" Foreground="{StaticResource MutedTextBrush}" Text="No Media Roots yet."/>
      <ItemsControl x:Name="MediaRootsList"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="#111319" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><DockPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="{Binding DisplayName}"/><Border Margin="10,0,0,0" Padding="7,2" CornerRadius="8" Background="#34261A"><TextBlock FontSize="10" Foreground="{StaticResource OrangeBrush}" Text="{Binding Availability}"/></Border></DockPanel><TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding PhysicalPath}"/><TextBlock Margin="0,3,0,0" Foreground="#D7A25C" TextWrapping="Wrap" Text="{Binding Diagnostic}"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Rename" Click="RenameMediaRoot_Click"/><Button Content="Reconnect…" Click="ReconnectMediaRoot_Click"/></StackPanel>
       </Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
     <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Margin="4,0,4,12" Text="Batch Encode Defaults"/>
      <StackPanel Grid.Row="1" Margin="0,0,8,0"><TextBlock Style="{StaticResource FieldLabel}" Text="RESOLUTION"/><ComboBox x:Name="SettingsResolution"><ComboBoxItem Content="480p (854×480)"/><ComboBoxItem Content="720p (1280×720)"/><ComboBoxItem Content="1080p (1920×1080)"/><ComboBoxItem Content="1440p (2560×1440)"/><ComboBoxItem Content="4K UHD (3840×2160)"/><ComboBoxItem Content="Source resolution"/></ComboBox></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="RECOVERY MODE"/><ComboBox x:Name="SettingsRecoveryMode"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Salvage audio + video"/><ComboBoxItem Content="Video only"/></ComboBox></StackPanel>
      <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="4,8,0,0"><CheckBox x:Name="SettingsRecursive" Content="Include subfolders by default" Checked="SettingsRecursive_Changed" Unchecked="SettingsRecursive_Changed"/><CheckBox x:Name="SettingsPreserveFolderStructure" Content="Preserve source folder structure by default" Visibility="Collapsed"/><CheckBox x:Name="SettingsOverwriteExisting" Content="Overwrite existing output files by default"/></WrapPanel>

     </Grid></Border>
     <Border Grid.Row="5" Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Style="{StaticResource SectionTitle}" Margin="4,0,4,4" Text="Encoding Quality"/>
       <TextBlock Margin="4,0,4,12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Choose a named starting point, then fine-tune individual options. NVIDIA NVENC is available now; CPU, AMD, and Intel backends are reserved for later releases."/>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="Apply Preset" Click="ApplyEncodingPreset_Click"/>
        <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="NAMED PRESET"/><ComboBox x:Name="SettingsEncodingPreset"><ComboBoxItem Content="Recommended"/><ComboBoxItem Content="Maximum Quality"/><ComboBoxItem Content="Fast Preview"/><ComboBoxItem Content="Efficient HEVC"/><ComboBoxItem Content="Custom" IsEnabled="False"/></ComboBox></StackPanel>
       </DockPanel>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="ENCODER"/><ComboBox x:Name="SettingsEncoderBackend" IsEnabled="False"><ComboBoxItem Content="NVIDIA NVENC"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="VIDEO CODEC"/><ComboBox x:Name="SettingsVideoCodec"><ComboBoxItem Content="H.264"/><ComboBoxItem Content="HEVC (H.265)"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="CONTAINER"/><ComboBox x:Name="SettingsContainer"><ComboBoxItem Content="MP4"/><ComboBoxItem Content="MKV"/><ComboBoxItem Content="MOV"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="AUDIO"/><ComboBox x:Name="SettingsAudioMode"><ComboBoxItem Content="Copy source"/><ComboBoxItem Content="AAC"/><ComboBoxItem Content="No audio"/></ComboBox></StackPanel>
       </Grid>
       <Expander Margin="4,12,4,0" Header="Advanced encoding options" Foreground="{StaticResource TextBrush}">
        <StackPanel Margin="0,8,0,0">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="NVENC PRESET (P1–P7)"/><TextBox x:Name="SettingsEncoderPreset"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="TUNING"/><ComboBox x:Name="SettingsTune"><ComboBoxItem Content="High quality"/><ComboBoxItem Content="Low latency"/><ComboBoxItem Content="Ultra-low latency"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="RATE CONTROL"/><ComboBox x:Name="SettingsRateControl"><ComboBoxItem Content="Constant quality"/><ComboBoxItem Content="Variable bitrate"/><ComboBoxItem Content="Constant bitrate"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="MULTIPASS"/><ComboBox x:Name="SettingsMultipass"><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="Quarter resolution"/><ComboBoxItem Content="Full resolution"/></ComboBox></StackPanel>
         </Grid>
         <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="QUALITY (0–51)"/><TextBox x:Name="SettingsQuality"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="TARGET BITRATE (MBPS)"/><TextBox x:Name="SettingsTargetBitrate"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="MAX BITRATE (MBPS)"/><TextBox x:Name="SettingsMaxBitrate"/></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="AQ STRENGTH (1–15)"/><TextBox x:Name="SettingsAqStrength"/></StackPanel>
         </Grid>
         <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="PIXEL FORMAT"/><ComboBox x:Name="SettingsPixelFormat"><ComboBoxItem Content="8-bit YUV 4:2:0"/><ComboBoxItem Content="10-bit P010 (HEVC)"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="FRAME RATE"/><ComboBox x:Name="SettingsFrameRate"><ComboBoxItem Content="Source"/><ComboBoxItem Content="23.976"/><ComboBoxItem Content="24"/><ComboBoxItem Content="25"/><ComboBoxItem Content="29.97"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="59.94"/><ComboBoxItem Content="60"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="AAC BITRATE (KBPS)"/><TextBox x:Name="SettingsAudioBitrate"/></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="AUDIO SAMPLE RATE"/><ComboBox x:Name="SettingsAudioSampleRate"><ComboBoxItem Content="Source"/><ComboBoxItem Content="44.1 kHz"/><ComboBoxItem Content="48 kHz"/><ComboBoxItem Content="96 kHz"/></ComboBox></StackPanel>
         </Grid>
         <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="AUDIO CHANNELS"/><ComboBox x:Name="SettingsAudioChannels"><ComboBoxItem Content="Source"/><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/></ComboBox></StackPanel>
          <WrapPanel Grid.Column="1" Margin="8,22,0,0"><CheckBox x:Name="SettingsDeinterlace" Content="Deinterlace"/><CheckBox x:Name="SettingsSpatialAq" Content="Spatial AQ"/><CheckBox x:Name="SettingsTemporalAq" Content="Temporal AQ"/><CheckBox x:Name="SettingsFastStart" Content="Fast start for MP4/MOV"/></WrapPanel>
         </Grid>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Border>
     <Border Grid.Row="6" Style="{StaticResource Card}">
      <StackPanel>
       <DockPanel Margin="4,0,4,12">
        <Button DockPanel.Dock="Right" Padding="12,6" Content="Check Again" Click="CheckDependencies_Click"/>
        <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Encoding Requirements"/><TextBlock x:Name="DependencySummary" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Checking the tools needed for encoding…"/></StackPanel>
       </DockPanel>
       <ItemsControl x:Name="DependencyResults" Margin="4,0,4,12">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="{Binding Name}"/>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding Summary}" ToolTip="{Binding Detail}"/>
          <ToggleButton Grid.Column="3" x:Name="RequirementHelpButton" Style="{StaticResource RequirementInfoButton}" Content="i"
           MouseEnter="RequirementHelp_MouseEnter" MouseLeave="RequirementHelp_MouseLeave"/>
          <Popup IsOpen="{Binding IsChecked, ElementName=RequirementHelpButton, Mode=TwoWay}" PlacementTarget="{Binding ElementName=RequirementHelpButton}" Placement="Right" HorizontalOffset="8" AllowsTransparency="True" StaysOpen="True">
           <Border Width="340" Padding="14" Background="#20242C" BorderBrush="#596270" BorderThickness="1" CornerRadius="8"
            Tag="{Binding ElementName=RequirementHelpButton}" MouseLeftButtonUp="RequirementHelpPopup_Click">
            <StackPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding Resolution}"/><TextBlock Margin="0,7,0,0" Foreground="#7F8998" FontSize="11" TextWrapping="Wrap" Text="{Binding Detail}"/></StackPanel>
           </Border>
          </Popup>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock Style="{StaticResource FieldLabel}" Text="FFMPEG EXECUTABLE"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseSettingsFfmpeg_Click"/><TextBox x:Name="SettingsFfmpegPath"/></DockPanel>
       <TextBlock Margin="6,5,4,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Leave blank to use a bundled FFmpeg or the first copy available on PATH. FFprobe is detected beside FFmpeg or on PATH."/>
      </StackPanel>
     </Border>
     <DockPanel Grid.Row="7" Margin="2,0"><TextBlock x:Name="SettingsMessage" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Restore Defaults" Click="ResetSettings_Click"/><Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Content="Save Settings" Click="SaveSettings_Click"/></StackPanel></DockPanel>
    </Grid></ScrollViewer>
   </TabItem>

   <TabItem>
    <Grid Margin="28,24,28,28"><Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620" Padding="28">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image Source="Assets/Branding/jr-glow-source.png" Width="190" Height="190" Stretch="Uniform"/>
      <StackPanel Grid.Column="1" Margin="24,10,0,0"><TextBlock Style="{StaticResource PageTitle}" Text="Lightflow Studio"/><TextBlock Margin="0,4,0,16" Foreground="{StaticResource OrangeBrush}" FontSize="12" FontWeight="SemiBold" Text="JEREMY RUNNING PHOTOGRAPHY"/><TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="20" Text="Video processing and workflow tools for batch encoding, media inspection, recovery, and Premiere Pro exports."/><Border Height="2" Margin="0,22,0,16" Background="{StaticResource BrandGradient}"/><TextBlock x:Name="AboutVersionText" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
     </Grid>
    </Border></Grid>
   </TabItem>
  </TabControl>

  <!--
   One application-wide status strip rather than a Browser-specific bar stacked above an unrelated global
   one (#126): app health (Ellipse + StatusText) always occupies the left/fill side; the Browser-specific
   segment (count/selection/Preview activity, then a reserved slot for #125's thumbnail-size control) docks
   to the right and is shown only while the Browser tab is active — see MainWindow.SyncBrowserStatusBarVisibility.
  -->
  <Border Grid.Row="2" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,1,0,0" Padding="14,0">
   <DockPanel LastChildFill="True">
    <!-- #125: thumbnail-size control, the integration point #126 reserved here. No permanent text label —
         a small/large rendering of the same glyph flanks the slider (now clickable one-step decrease/
         increase buttons, not just decorative), and every control here carries its own accessible name/
         tooltip; understandable through iconography/tooltip/accessibility text alone. IsEnabled on the two
         buttons is kept current by MainWindow.ApplyBrowserThumbnailSize, the same single apply point the
         slider already used — no XAML default declared here, matching that method being the sole source of
         truth for every visual this control shows. -->
    <StackPanel x:Name="BrowserPresentationControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
     <Button x:Name="BrowserThumbnailSizeDecreaseButton" Style="{StaticResource BrowserThumbnailSizeStepButtonStyle}" FontSize="9"
      Content="&#xE80A;" ToolTip="Decrease thumbnail size" AutomationProperties.Name="Decrease thumbnail size"
      Click="BrowserThumbnailSizeDecreaseButton_Click"/>
     <Slider x:Name="BrowserThumbnailSizeSlider" Style="{StaticResource BrowserThumbnailSizeSliderStyle}" Margin="6,0"
      Minimum="0" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
      ToolTip="Thumbnail size" AutomationProperties.Name="Thumbnail size"
      ValueChanged="BrowserThumbnailSizeSlider_ValueChanged"/>
     <Button x:Name="BrowserThumbnailSizeIncreaseButton" Style="{StaticResource BrowserThumbnailSizeStepButtonStyle}" FontSize="15"
      Content="&#xE80A;" ToolTip="Increase thumbnail size" AutomationProperties.Name="Increase thumbnail size"
      Click="BrowserThumbnailSizeIncreaseButton_Click"/>
    </StackPanel>
    <TextBlock x:Name="BrowserStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
     FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,0,14,0" Visibility="Collapsed"/>
    <Border x:Name="BrowserStatusDivider" DockPanel.Dock="Right" Width="1" Margin="0,9,14,9" Background="{StaticResource ShellDividerBrush}" Visibility="Collapsed"/>
    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
     TextTrimming="CharacterEllipsis" Text="Checking FFmpeg…"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
